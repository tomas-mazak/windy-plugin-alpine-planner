# Copy to .env (git-ignored, never commit it) and fill in, or set these as environment variables.

# --- End-to-end tests (npm run test:e2e) ---
# The Windy client to test, without a trailing slash; empty means https://www.windy.com.
WINDY_URL=
# The free test account's Windy login (user name or e-mail).
WINDY_FREE_USER=
# The free test account's password.
WINDY_FREE_PASSWORD=
# The premium test account's Windy login (user name or e-mail).
WINDY_PREMIUM_USER=
# The premium test account's password.
WINDY_PREMIUM_PASSWORD=

# --- Publishing to Windy's plugin gallery (./publish.sh) ---
# Your Windy plugin API key (https://docs.windy-plugins.com/); never printed or logged.
WINDY_API_KEY=
# Your Windy user name, shown as the plugin's owner.
WINDY_PLUGIN_OWNER=
# The URL of the plugin's public source repository.
WINDY_PLUGIN_REPOSITORY=
